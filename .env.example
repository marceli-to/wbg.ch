APP_NAME="WBG AG - VISUELLE KOMMUNIKATION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Canonical host: used for canonical links, sitemap.xml and llms.txt
APP_URL=https://wbg.ch

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@wbg.ch
MAIL_FROM_NAME="${APP_NAME}"

# Non-production only (e.g. staging): HTTP Basic Auth for the whole site.
# Leave empty in production.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
